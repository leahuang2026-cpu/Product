{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/domain.test.ts tests/os.test.ts",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx scripts/validate-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:contract": "tsx --test tests/contract.test.ts tests/trash-contract.test.ts",
    "test:backup": "node --import tsx tests/backup.test.ts && node --import tsx tests/backup-contract.test.ts && node --import tsx tests/backup-preview.test.ts",
    "benchmark:backup": "node --import tsx scripts/benchmark-backup.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.58.0",
    "@prisma/internals": "6.19.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
