# Local-only configuration: copy to .env.local and fill securely; never commit values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PERSONAL_OS_OWNER_EMAIL=
# Optional additional identity pin; verified owner email is required regardless.
PERSONAL_OS_OWNER_ID=
# Actual application origin for CSRF and Auth callback allowlist.
APP_ORIGIN=
# Keep disabled until the separately reviewed SQL/RLS/Storage contract is applied and tested.
PERSONAL_OS_DATA_CONTRACT=
# Pending audio-size agreement; blank disables audio upload (recording preview still works).
PERSONAL_OS_MAX_AUDIO_BYTES=
# Legacy Prisma design only; never migrate the old 13-model schema into the cloud by default.
DATABASE_URL="postgresql://personal_os:CHANGE_ME@localhost:5432/personal_os?schema=public"
